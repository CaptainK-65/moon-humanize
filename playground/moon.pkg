import {
  "CaptainK-65/moon-humanize/common",
  "CaptainK-65/moon-humanize/duration",
  "CaptainK-65/moon-humanize/bytes",
  "CaptainK-65/moon-humanize/reltime",
}

pkgtype(kind: "foreign_library")

options(
  link: {
    "js": {
      "exports": [
        "duration_zh",
        "duration_en",
        "bytes_format",
        "relative_zh",
        "relative_en",
      ],
      "format": "esm",
    },
    "wasm-gc": {
      "exports": [
        "duration_zh",
        "duration_en",
        "bytes_format",
        "relative_zh",
        "relative_en",
      ],
      "use-js-builtin-string": true,
    },
  },
)
